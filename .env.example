# Personal local application; Compose supplies its own PostgreSQL URL.
DATABASE_URL=sqlite:///./research_navigator.db
APP_MODE=local
# Hosted public demo only: exact hostname and a random secret of at least 32 characters.
PUBLIC_HOST=
SESSION_SECRET=

# Optional credentials, backend only. Keep this file's copied .env out of Git.
OPENALEX_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GROQ_API_KEY=
# Comma-separated free Groq models, tried in order when one is rate-limited or unavailable.
GROQ_MODEL=openai/gpt-oss-120b,openai/gpt-oss-20b
GROQ_REQUESTS_PER_DAY=6

CACHE_TTL_HOURS=24
AI_TURNS_PER_DAY=3
GEMINI_REQUESTS_PER_DAY=6
OPENALEX_REQUESTS_PER_DAY=20
PROVIDER_CONCURRENCY=2
PROVIDER_ATTEMPTS=2
PROVIDER_TIMEOUT_SECONDS=20
REQUEST_TIMEOUT_SECONDS=60
MAX_ACTIVE_REQUESTS=5
MAX_RESPONSE_BYTES=4000000
CHAT_RETENTION_DAYS=30
